        return (
            f"PredictorEvaluator(\n"
            f"  target='{self.target}',\n"
            f"  history_size={self.history_size},\n"
            f"  max_steps={self.max_steps},\n"
            f"  n_datasets={len(self.local_datasets)},\n"
            f"  n_models={len(self.model_names)}\n"
            f")"
        )