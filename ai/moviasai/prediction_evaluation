    def export_results(self, output_dir: Optional[str] = None) -> Dict[str, Path]:
        """Exporta resultados"""
        if output_dir:
            output_path = Path(output_dir)
            output_path.mkdir(parents=True, exist_ok=True)
        else:
            output_path = Path('.')
        
        exported = {}
        
        print("💾 Exportando resultados...")
        
        for model_name in self.metrics.keys():
            all_results = []
            
            for class_id, df in self.metrics[model_name].items():
                df_copy = df.copy()
                df_copy['model'] = model_name
                all_results.append(df_copy)
            
            df_consolidated = pd.concat(all_results, ignore_index=True)
            
            filename = f'predictor_{model_name}_{self.target}_hist{self.history_size}.csv'
            filepath = output_path / filename
            
            df_consolidated.to_csv(filepath, index=False)
            exported[model_name] = filepath
            
            if self.verbose:
                file_size = filepath.stat().st_size / 1024
                print(f"  ✓ {model_name}: {file_size:.1f} KB")
        
        # Exportar max_steps cases
        for model_name in self.max_steps_cases.keys():
            all_max = []
            
            for class_id, cases in self.max_steps_cases[model_name].items():
                if cases:
                    df_cases = pd.DataFrame(cases)
                    df_cases['model'] = model_name
                    all_max.append(df_cases)
            
            if all_max:
                df_max = pd.concat(all_max, ignore_index=True)
                
                filename = f'predictor_maxsteps_{model_name}_{self.target}_hist{self.history_size}.csv'
                filepath = output_path / filename
                
                df_max.to_csv(filepath, index=False)
                
                if self.verbose:
                    file_size = filepath.stat().st_size / 1024
                    print(f"  ⚠️  {model_name} (max_steps): {file_size:.1f} KB")
        
        if self.verbose:
            print()
        
        return exported
    
    def get_summary_table(self) -> pd.DataFrame:
        """Tabela resumo"""
        rows = []
        
        for model_name in self.model_names:
            if model_name not in self.metrics:
                continue
            
            for class_id, df in self.metrics[model_name].items():
                n_excluded = len(self.max_steps_cases.get(model_name, {}).get(class_id, []))
                
                rows.append({
                    'model': model_name,
                    'class': class_id,
                    'n_samples': len(df),
                    'n_excluded': n_excluded,
                    'acc_mae': df['acc_abs_error'].mean(),
                    'acc_mape': df['acc_pct_error'].abs().mean(),
                    'steps_mae': df['steps_abs_error'].mean(),
                    'steps_median_ae': df['steps_abs_error'].median(),
                    'accuracy_exact': df['steps_exact_match'].mean() * 100,
                    'accuracy_within_3': df['steps_within_3'].mean() * 100
                })
        
        return pd.DataFrame(rows)
    
    def clear_cache(self):
        """Remove cache"""
        cache_files = list(self.cache_dir.glob('pred_*.pkl'))
        
        if not cache_files:
            print("Nenhum cache encontrado")
            return
        
        print(f"🗑️  Removendo {len(cache_files)} arquivo(s)...")
        
        for cache_file in cache_files:
            try:
                cache_file.unlink()
                if self.verbose:
                    print(f"  ✓ {cache_file.name}")
            except Exception as e:
                warnings.warn(f"Erro: {e}")
        
        print("✓ Cache limpo")
    
