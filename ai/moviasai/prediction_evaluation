import numpy as np
import pandas as pd
import pickle
import hashlib
import warnings
import re
from pathlib import Path
from typing import List, Optional, Dict, Any
import matplotlib.pyplot as plt
from tqdm import tqdm

from vehicle_profile import VehicleProfile
from dataset_loader import DatasetLoader

from prediction import Predictor

from darts.models import (
    DLinearModel, NLinearModel, TSMixerModel, TCNModel,
    NBEATSModel, NHiTSModel, LightGBMModel, XGBModel,
    LinearRegressionModel
)


class PredictorEvaluator:
    """
    Avaliador otimizado do Predictor
    
    Otimizações:
    - Progress bar para acompanhamento
    - max_steps reduzido (90 dias padrão)
    - Detecção e exclusão de casos max_steps
    - Diagnóstico de casos problemáticos
    """
    
    def __init__(
        self,
        models_dir: str,
        datasets_dir: str,
        vp: VehicleProfile,
        history_size: int = 28,
        model_names: Optional[List[str]] = None,
        cache_dir: str = '.cache/predictor',
        max_steps: int = 90,  # REDUZIDO de 365 para 90
        verbose: bool = True,
        suppress_warnings: bool = True
    ):
        """Inicializa o avaliador"""
        self.models_dir = Path(models_dir)
        self.datasets_dir = Path(datasets_dir)
        self.vp = vp
        self.history_size = history_size
        self.cache_dir = Path(cache_dir)
        self.max_steps = max_steps
        self.verbose = verbose
        
        # Suprimir warnings
        if suppress_warnings:
            self._suppress_warnings()
        
        self.cache_dir.mkdir(parents=True, exist_ok=True)
        
        self.target = vp.target
        
        if self.verbose:
            print("=" * 80)
            print("🔮 INICIALIZANDO AVALIAÇÃO DO PREDICTOR")
            print("=" * 80)
            print(f"Models dir: {self.models_dir}")
            print(f"Datasets dir: {self.datasets_dir}")
            print(f"Target: {self.target}")
            print(f"History size: {history_size}")
            print(f"Max steps: {max_steps}")
            print()
        
        # Descobrir datasets
        self.local_datasets = self._discover_local_datasets()
        
        if not self.local_datasets:
            raise ValueError(
                f"Nenhum dataset encontrado para target '{self.target}' "
                f"e history_size={history_size}"
            )
        
        if self.verbose:
            print(f"✓ {len(self.local_datasets)} dataset(s) encontrado(s):")
            for ds_info in self.local_datasets:
                class_ids = ds_info['class_id']
                fh = ds_info['forecast_horizon']
                print(f"  • {ds_info['dataset_name']} (classes {class_ids}, fh={fh})")
            print()
        
        # Descobrir modelos
        self.available_models = self._discover_models()
        
        if model_names:
            self.model_names = [m for m in model_names if m in self.available_models]
        else:
            self.model_names = list(self.available_models.keys())
        
        if self.verbose:
            print(f"Modelos disponíveis: {list(self.available_models.keys())}")
            print(f"Modelos a avaliar: {self.model_names}")
            print("=" * 80)
            print()
        
        self.predictions = {}
        self.metrics = {}
        self.max_steps_cases = {}
    
    def _suppress_warnings(self):
        """Suprime warnings de bibliotecas"""
        import os
        import logging
        
        os.environ['TF_CPP_MIN_LOG_LEVEL'] = '3'
        os.environ['TF_ENABLE_ONEDNN_OPTS'] = '0'
        
        logging.getLogger('pytorch_lightning').setLevel(logging.ERROR)
        logging.getLogger('lightning_fabric').setLevel(logging.ERROR)
        logging.getLogger('lightning.pytorch').setLevel(logging.ERROR)
        
        warnings.filterwarnings('ignore', category=FutureWarning)
        warnings.filterwarnings('ignore', category=UserWarning)
        warnings.filterwarnings('ignore', message='.*num_workers.*')
    
    def _discover_local_datasets(self) -> List[Dict[str, Any]]:
        """Descobre datasets locais"""
        datasets = []
        
        for dataset_path in self.datasets_dir.iterdir():
            if not dataset_path.is_dir():
                continue
            
            dirname = dataset_path.name
            
            match_hist = re.search(r'hist(\d+)', dirname)
            if not match_hist:
                continue
            dataset_hist = int(match_hist.group(1))
            
            if dataset_hist != self.history_size:
                continue
            
            match_fh = re.search(r'fh(\d+)', dirname)
            if not match_fh:
                continue
            dataset_fh = int(match_fh.group(1))
            
            match_target = re.search(r'dataset_([^_]+(?:_[^_]+)*)(?=_hist)', dirname)
            if not match_target:
                continue
            dataset_target = match_target.group(1)
            
            if dataset_target != self.target:
                continue
            
            class_files = list(dataset_path.glob('class*.csv'))
            
            if not class_files:
                continue
            
            class_ids = []
            split_names = []
            
            for class_file in class_files:
                match_class = re.search(r'class(\d+)\.csv', class_file.name)
                if not match_class:
                    continue
                
                class_id = int(match_class.group(1))
                class_ids.append(class_id)
                split_names.append(class_file.stem)
            
            if class_ids:
                datasets.append({
                    'dataset_name': dirname,
                    'class_id': class_ids,
                    'forecast_horizon': dataset_fh,
                    'history_size': dataset_hist,
                    'split_names': split_names,
                    'path': dataset_path
                })
        
        datasets.sort(key=lambda x: (x['class_id'][0] if x['class_id'] else 0, x['forecast_horizon']))
        
        return datasets
    
    def _discover_models(self) -> Dict[str, Dict[int, Any]]:
        """Descobre modelos"""
        models = {}
        
        for model_dir in self.models_dir.iterdir():
            if not model_dir.is_dir():
                continue
            
            model_name = model_dir.name
            models[model_name] = {}
            
            all_class_ids = set()
            for ds_info in self.local_datasets:
                all_class_ids.update(ds_info['class_id'])
            
            for class_id in sorted(all_class_ids):
                pattern = f"dataset_{self.target}_*_class{class_id}_hist{self.history_size}_fh*"
                
                matching_dirs = list(model_dir.glob(pattern))
                
                if not matching_dirs:
                    continue
                
                model_subdir = matching_dirs[0]
                
                checkpoints_torch = list(model_subdir.glob('model_*/checkpoints/*.ckpt'))
                checkpoints_pkl = list(model_subdir.glob('model_*.pkl'))
                
                if not checkpoints_torch and not checkpoints_pkl:
                    continue
                
                is_torch = len(checkpoints_torch) > 0
                
                match_fh = re.search(r'_fh(\d+)_', model_subdir.name)
                if match_fh:
                    model_fh = int(match_fh.group(1))
                else:
                    model_fh = 7
                
                models[model_name][class_id] = {
                    'work_dir': model_subdir,
                    'is_torch': is_torch,
                    'model_forecast_horizon': model_fh
                }
        
        models = {k: v for k, v in models.items() if v}
        
        return models
    
    def _load_model(self, model_name: str, class_id: int):
        """Carrega modelo"""
        model_info = self.available_models[model_name][class_id]
        work_dir = model_info['work_dir']
        is_torch = model_info['is_torch']
        
        model_classes = {
            'DLinearModel': DLinearModel,
            'NLinearModel': NLinearModel,
            'TSMixerModel': TSMixerModel,
            'TCNModel': TCNModel,
            'NBEATSModel': NBEATSModel,
            'NHiTSModel': NHiTSModel,
            'LightGBMModel': LightGBMModel,
            'XGBModel': XGBModel,
            'LinearRegressionModel': LinearRegressionModel
        }
        
        model_cls = model_classes.get(model_name)
        
        if model_cls is None:
            raise ValueError(f"Modelo {model_name} não suportado")
        
        if not is_torch:
            model_path = work_dir / 'model_00.pkl'
            return model_cls.load(str(model_path))
        
        try:
            model = model_cls.load_from_checkpoint(
                model_name='model_00',
                work_dir=str(work_dir),
                best=True
            )
            return model
        except Exception as e:
            raise RuntimeError(f"Erro ao carregar {model_name}/class{class_id}: {e}")
    
    def _compute_predictions_cache_hash(self, model_name: str, class_id: int) -> str:
        """Computa hash para cache"""
        model_info = self.available_models[model_name][class_id]
        work_dir = model_info['work_dir']
        
        model_path = work_dir / 'model_00.pkl'
        if not model_path.exists():
            model_path = work_dir / 'model_00'
        
        if model_path.exists():
            mtime = model_path.stat().st_mtime
        else:
            mtime = 0
        
        hash_str = f"{model_name}_class{class_id}_{mtime}_{self.max_steps}"
        
        return hashlib.md5(hash_str.encode()).hexdigest()
    
    def _try_load_predictions_from_cache(
        self,
        model_name: str,
        class_id: int
    ) -> Optional[Dict[str, Any]]:
        """Tenta carregar do cache"""
        cache_hash = self._compute_predictions_cache_hash(model_name, class_id)
        cache_file = self.cache_dir / f'pred_{cache_hash}.pkl'
        
        if not cache_file.exists():
            return None
        
        try:
            if self.verbose:
                print(f"    📦 Carregando do cache...")
            
            with open(cache_file, 'rb') as f:
                cached_data = pickle.load(f)
            
            if self.verbose:
                print(f"    ✓ Cache carregado")
            
            return cached_data
        except Exception as e:
            warnings.warn(f"Erro ao carregar cache: {e}")
            return None
    
    def _save_predictions_to_cache(
        self,
        model_name: str,
        class_id: int,
        predictions_data: Dict[str, Any]
    ):
        """Salva no cache"""
        cache_hash = self._compute_predictions_cache_hash(model_name, class_id)
        cache_file = self.cache_dir / f'pred_{cache_hash}.pkl'
        
        try:
            with open(cache_file, 'wb') as f:
                pickle.dump(predictions_data, f, protocol=pickle.HIGHEST_PROTOCOL)
            
            if self.verbose:
                file_size = cache_file.stat().st_size / (1024 * 1024)
                print(f"    💾 Cache salvo ({file_size:.2f} MB)")
        except Exception as e:
            warnings.warn(f"Erro ao salvar cache: {e}")
    
    def predict_all(self, use_cache: bool = True, force_reload: bool = False):
        """Gera predições com PROGRESS BAR"""
        
        if self.verbose:
            print("=" * 80)
            print("🔮 GERANDO PREDIÇÕES")
            print("=" * 80)
            print()
        
        for model_name in self.model_names:
            if self.verbose:
                print(f"\nModelo: {model_name}")
                print("-" * 80)
            
            self.predictions[model_name] = {}
            self.max_steps_cases[model_name] = {}
            
            all_class_ids = set()
            for ds_info in self.local_datasets:
                all_class_ids.update(ds_info['class_id'])
            
            for class_id in sorted(all_class_ids):
                if self.verbose:
                    print(f"  Classe {class_id}:")
                
                if class_id not in self.available_models.get(model_name, {}):
                    if self.verbose:
                        print(f"    ⚠️  Modelo não encontrado")
                    continue
                
                # Tentar cache
                cached_pred = None
                if use_cache and not force_reload:
                    cached_pred = self._try_load_predictions_from_cache(
                        model_name, class_id
                    )
                
                if cached_pred is not None:
                    self.predictions[model_name][class_id] = cached_pred['predictions']
                    self.max_steps_cases[model_name][class_id] = cached_pred['max_steps_cases']
                    if self.verbose:
                        print(f"    ✓ Carregado do cache")
                    continue
                
                try:
                    model = self._load_model(model_name, class_id)
                    model_fh = self.available_models[model_name][class_id]['model_forecast_horizon']
                    
                    predictor = Predictor(
                        model=model,
                        history_size=self.history_size,
                        forecast_horizon=model_fh,
                        max_steps=self.max_steps,
                        verbose=False
                    )
                    
                    # Coletar todos os dados
                    all_data = []
                    
                    for ds_info in self.local_datasets:
                        if class_id not in ds_info['class_id']:
                            continue
                        
                        idx = ds_info['class_id'].index(class_id)
                        split_name = ds_info['split_names'][idx]
                        
                        try:
                            dataset_loader = DatasetLoader(ds_info['path'], vp=self.vp)
                            dataset = dataset_loader.load(
                                split=split_name,
                                cache_dir=str(self.cache_dir / 'dataset_cache')
                            )
                            
                            if len(dataset.output_series) == 0:
                                continue
                            
                            target_acc = [ts.values().sum() for ts in dataset.output_series]
                            target_steps = [ds_info['forecast_horizon']] * len(dataset.output_series)
                            
                            for i in range(len(dataset.input_series)):
                                all_data.append({
                                    'input_series': dataset.input_series[i],
                                    'input_past_cov': dataset.input_past_covariates[i] if dataset.input_past_covariates else None,
                                    'target_acc_scaled': target_acc[i],
                                    'target_steps': target_steps[i],
                                    'vehicle_id': int(dataset.ids[i]),
                                    'dataset_name': ds_info['dataset_name']
                                })
                        
                        except Exception as e:
                            warnings.warn(f"Erro ao carregar {ds_info['dataset_name']}/{split_name}: {e}")
                            continue
                    
                    if not all_data:
                        if self.verbose:
                            print(f"    ⚠️  Nenhum dado carregado")
                        continue
                    
                    n_total = len(all_data)
                    
                    if self.verbose:
                        print(f"    Processando {n_total} séries...")
                    
                    # PROCESSAR COM PROGRESS BAR
                    all_results = []
                    max_steps_cases = []
                    
                    for data_item in tqdm(all_data, disable=not self.verbose, desc="      Progresso"):
                        try:
                            # 1. predict_accumulated_at_step
                            result_acc = predictor.predict_accumulated_at_step(
                                history=data_item['input_series'],
                                past_covariates=data_item['input_past_cov'],
                                n_steps=data_item['target_steps']
                            )
                            
                            # 2. date_to_reach_accumulated
                            result_date = predictor.date_to_reach_accumulated(
                                history=data_item['input_series'],
                                past_covariates=data_item['input_past_cov'],
                                target_value=data_item['target_acc_scaled']
                            )
                            
                            # Desnormalizar
                            vehicle_id = data_item['vehicle_id']
                            last_date = data_item['input_series'].end_time()
                            
                            acc_pred_scaled = result_acc['accumulated_value']
                            acc_pred = self.vp.inverse_transform(
                                vehicle_id=vehicle_id,
                                scaled_values=np.array([acc_pred_scaled]),
                                date=last_date
                            )[0]
                            
                            acc_real_scaled = data_item['target_acc_scaled']
                            acc_real = self.vp.inverse_transform(
                                vehicle_id=vehicle_id,
                                scaled_values=np.array([acc_real_scaled]),
                                date=last_date
                            )[0]
                            
                            steps_pred = result_date['n_steps']
                            
                            # Estatísticas do histórico
                            hist_values_scaled = data_item['input_series'].values().flatten()
                            hist_values = self.vp.inverse_transform(
                                vehicle_id=vehicle_id,
                                scaled_values=hist_values_scaled,
                                date=last_date
                            )
                            
                            result_dict = {
                                'dataset': data_item['dataset_name'],
                                'veiculo_id': vehicle_id,
                                'forecast_size': data_item['target_steps'],
                                'acc_real': acc_real,
                                'acc_pred': acc_pred,
                                'steps_real': data_item['target_steps'],
                                'steps_pred': steps_pred,
                                'hist_mean': hist_values.mean(),
                                'hist_median': np.median(hist_values),
                                'hist_max': hist_values.max(),
                                'hist_sum': hist_values.sum(),
                                'target_value': acc_real
                            }
                            
                            # Detectar max_steps
                            if steps_pred == predictor.max_steps:
                                max_steps_cases.append(result_dict)
                            else:
                                all_results.append(result_dict)
                        
                        except Exception as e:
                            warnings.warn(f"Erro em veículo {data_item['vehicle_id']}: {e}")
                            continue
                    
                    # Salvar resultados
                    predictions_data = {
                        'class_id': class_id,
                        'results': all_results
                    }
                    
                    cache_data = {
                        'predictions': predictions_data,
                        'max_steps_cases': max_steps_cases
                    }
                    
                    self.predictions[model_name][class_id] = predictions_data
                    self.max_steps_cases[model_name][class_id] = max_steps_cases
                    
                    if use_cache:
                        self._save_predictions_to_cache(
                            model_name, class_id, cache_data
                        )
                    
                    if self.verbose:
                        print(f"    ✓ {len(all_results)} predições válidas")
                        if max_steps_cases:
                            print(f"    ⚠️  {len(max_steps_cases)} casos atingiram max_steps (excluídos)")
                
                except Exception as e:
                    print(f"    ❌ Erro: {e}")
                    import traceback
                    traceback.print_exc()
        
        if self.verbose:
            print("\n" + "=" * 80)
            print()
    
    def calculate_metrics(self):
        """Calcula métricas (apenas casos válidos)"""
        if self.verbose:
            print("=" * 80)
            print("📊 CALCULANDO MÉTRICAS")
            print("=" * 80)
            print()
        
        for model_name, classes_pred in self.predictions.items():
            if self.verbose:
                print(f"\nModelo: {model_name}")
                print("-" * 80)
            
            self.metrics[model_name] = {}
            
            for class_id, pred_data in classes_pred.items():
                if self.verbose:
                    print(f"  Classe {class_id}:")
                
                results = pred_data['results']
                
                if not results:
                    if self.verbose:
                        print(f"    ⚠️  Sem resultados válidos")
                    continue
                
                df_results = pd.DataFrame(results)
                
                # Erros ACUMULADO
                df_results['acc_error'] = df_results['acc_pred'] - df_results['acc_real']
                df_results['acc_abs_error'] = df_results['acc_error'].abs()
                df_results['acc_pct_error'] = 100 * df_results['acc_error'] / df_results['acc_real']
                
                # Erros STEPS
                df_results['steps_error'] = df_results['steps_pred'] - df_results['steps_real']
                df_results['steps_abs_error'] = df_results['steps_error'].abs()
                
                # Acurácias
                df_results['steps_exact_match'] = (df_results['steps_pred'] == df_results['steps_real']).astype(int)
                df_results['steps_within_1'] = (df_results['steps_abs_error'] <= 1).astype(int)
                df_results['steps_within_3'] = (df_results['steps_abs_error'] <= 3).astype(int)
                df_results['steps_within_7'] = (df_results['steps_abs_error'] <= 7).astype(int)
                
                df_results['class'] = class_id
                
                self.metrics[model_name][class_id] = df_results
                
                if self.verbose:
                    print(f"    ✓ {len(df_results)} amostras válidas")
        
        if self.verbose:
            print("\n" + "=" * 80)
            print()
    
    def print_max_steps_diagnostics(self):
        """Diagnóstico de casos que atingiram max_steps"""
        print("=" * 80)
        print("⚠️  DIAGNÓSTICO: CASOS QUE ATINGIRAM MAX_STEPS")
        print("=" * 80)
        print()
        
        for model_name in self.model_names:
            if model_name not in self.max_steps_cases:
                continue
            
            has_cases = any(len(cases) > 0 for cases in self.max_steps_cases[model_name].values())
            
            if not has_cases:
                print(f"{model_name}: Nenhum caso atingiu max_steps ✓")
                continue
            
            print(f"\n{'='*80}")
            print(f"MODELO: {model_name}")
            print(f"{'='*80}\n")
            
            for class_id, cases in sorted(self.max_steps_cases[model_name].items()):
                if not cases:
                    continue
                
                print(f"Classe {class_id}: {len(cases)} casos")
                print("-" * 80)
                
                df_cases = pd.DataFrame(cases)
                
                print(f"  Histórico (últimos {self.history_size} dias):")
                print(f"    Média: min={df_cases['hist_mean'].min():.2f}, "
                      f"med={df_cases['hist_mean'].median():.2f}, "
                      f"max={df_cases['hist_mean'].max():.2f}")
                print(f"    Soma: min={df_cases['hist_sum'].min():.2f}, "
                      f"med={df_cases['hist_sum'].median():.2f}, "
                      f"max={df_cases['hist_sum'].max():.2f}")
                
                print(f"  Target:")
                print(f"    min={df_cases['target_value'].min():.2f}, "
                      f"med={df_cases['target_value'].median():.2f}, "
                      f"max={df_cases['target_value'].max():.2f}")
                
                df_cases['ratio_target_hist'] = df_cases['target_value'] / df_cases['hist_sum']
                print(f"  Razão Target/Hist_Sum:")
                print(f"    min={df_cases['ratio_target_hist'].min():.2f}, "
                      f"med={df_cases['ratio_target_hist'].median():.2f}, "
                      f"max={df_cases['ratio_target_hist'].max():.2f}")
                
                print(f"  Veículos: {sorted(df_cases['veiculo_id'].unique())[:10]}...")
                print()
        
        print("=" * 80)
        print()
    
    def print_summary(self):
        """Resumo das métricas"""
        print("=" * 80)
        print("📊 RESUMO DAS MÉTRICAS (casos válidos)")
        print("=" * 80)
        print()
        
        for model_name in self.model_names:
            if model_name not in self.metrics:
                continue
            
            print(f"\n{'='*80}")
            print(f"MODELO: {model_name}")
            print(f"{'='*80}\n")
            
            for class_id, df in sorted(self.metrics[model_name].items()):
                n_excluded = len(self.max_steps_cases.get(model_name, {}).get(class_id, []))
                
                print(f"Classe {class_id}:")
                print("-" * 80)
                
                n_samples = len(df)
                
                if n_excluded > 0:
                    print(f"  ⚠️  {n_excluded} casos excluídos (max_steps)")
                
                # Acumulado
                acc_mae = df['acc_abs_error'].mean()
                acc_mape = df['acc_pct_error'].abs().mean()
                acc_median_ape = df['acc_pct_error'].abs().median()
                
                print(f"  Acumulado ({n_samples} amostras):")
                print(f"    MAE: {acc_mae:.2f}, MAPE: {acc_mape:.2f}%, Median APE: {acc_median_ape:.2f}%")
                
                # Steps
                steps_mae = df['steps_abs_error'].mean()
                steps_median_ae = df['steps_abs_error'].median()
                steps_max_ae = df['steps_abs_error'].max()
                
                exact = df['steps_exact_match'].mean() * 100
                within_1 = df['steps_within_1'].mean() * 100
                within_3 = df['steps_within_3'].mean() * 100
                within_7 = df['steps_within_7'].mean() * 100
                
                print(f"  Steps ({n_samples} amostras):")
                print(f"    MAE: {steps_mae:.2f} dias, Median: {steps_median_ae:.0f} dias, Max: {steps_max_ae:.0f} dias")
                print(f"    Acurácia: Exata={exact:.1f}%, ±1={within_1:.1f}%, ±3={within_3:.1f}%, ±7={within_7:.1f}%")
                print()
            
            # Agregado
            print(f"AGREGADO:")
            print("-" * 80)
            
            all_df = pd.concat([df for df in self.metrics[model_name].values()], ignore_index=True)
            
            n_total = len(all_df)
            n_excluded_total = sum(len(cases) for cases in self.max_steps_cases.get(model_name, {}).values())
            
            if n_excluded_total > 0:
                print(f"  ⚠️  {n_excluded_total} casos excluídos no total")
            
            acc_mae_g = all_df['acc_abs_error'].mean()
            acc_mape_g = all_df['acc_pct_error'].abs().mean()
            
            steps_mae_g = all_df['steps_abs_error'].mean()
            steps_med_g = all_df['steps_abs_error'].median()
            exact_g = all_df['steps_exact_match'].mean() * 100
            within_3_g = all_df['steps_within_3'].mean() * 100
            
            print(f"  Total: {n_total} amostras")
            print(f"  Acumulado: MAE={acc_mae_g:.2f}, MAPE={acc_mape_g:.2f}%")
            print(f"  Steps: MAE={steps_mae_g:.2f} dias, Median={steps_med_g:.0f} dias")
            print(f"  Acurácia: Exata={exact_g:.1f}%, ±3={within_3_g:.1f}%")
            print()
        
        print("=" * 80)
        print()
    
    def compare_models(self, class_id: Optional[int] = None, metric: str = 'mae_steps', figsize: tuple = (14, 6)):
        """Compara modelos"""
        fig, axes = plt.subplots(1, 2, figsize=figsize)
        
        model_data = {}
        
        for model_name in self.model_names:
            if model_name not in self.metrics:
                continue
            
            values = []
            
            for cid, df in self.metrics[model_name].items():
                if class_id is not None and cid != class_id:
                    continue
                
                if metric == 'mae_acc':
                    values.extend(df['acc_abs_error'].values)
                elif metric == 'mape_acc':
                    values.extend(df['acc_pct_error'].abs().values)
                elif metric == 'mae_steps':
                    values.extend(df['steps_abs_error'].values)
                elif metric == 'accuracy_within_3':
                    values.append(df['steps_within_3'].mean() * 100)
            
            if values:
                model_data[model_name] = np.array(values)
        
        if not model_data:
            print("Nenhum dado válido")
            return
        
        # Boxplot
        ax1 = axes[0]
        bp = ax1.boxplot(
            list(model_data.values()),
            tick_labels=list(model_data.keys()),
            patch_artist=True,
            showfliers=False
        )
        
        colors = plt.cm.Set3(np.linspace(0, 1, len(model_data)))
        for patch, color in zip(bp['boxes'], colors):
            patch.set_facecolor(color)
            patch.set_alpha(0.8)
        
        ylabel = metric.replace('_', ' ').upper()
        ax1.set_ylabel(ylabel, fontsize=12, fontweight='bold')
        ax1.set_title('Distribuição', fontsize=14, fontweight='bold')
        ax1.grid(True, alpha=0.3, axis='y')
        plt.setp(ax1.xaxis.get_majorticklabels(), rotation=45, ha='right')
        
        # Ranking
        ax2 = axes[1]
        model_names = list(model_data.keys())
        
        if 'accuracy' in metric:
            medians = [np.median(v) for v in model_data.values()]
            sorted_idx = np.argsort(medians)[::-1]
        else:
            medians = [np.median(v) for v in model_data.values()]
            sorted_idx = np.argsort(medians)
        
        model_names_sorted = [model_names[i] for i in sorted_idx]
        medians_sorted = [medians[i] for i in sorted_idx]
        colors_sorted = [colors[i] for i in sorted_idx]
        
        bars = ax2.barh(range(len(model_names_sorted)), medians_sorted, color=colors_sorted, alpha=0.8)
        
        ax2.set_yticks(range(len(model_names_sorted)))
        ax2.set_yticklabels(model_names_sorted)
        ax2.set_xlabel(f'{ylabel} (Mediana)', fontsize=12, fontweight='bold')
        ax2.set_title('Ranking', fontsize=14, fontweight='bold')
        ax2.grid(True, alpha=0.3, axis='x')
        
        for i, (bar, val) in enumerate(zip(bars, medians_sorted)):
            if 'accuracy' in metric:
                ax2.text(val, i, f' {val:.1f}%', va='center', fontsize=10, fontweight='bold')
            else:
                ax2.text(val, i, f' {val:.2f}', va='center', fontsize=10, fontweight='bold')
        
        class_str = f"Classe {class_id}" if class_id is not None else "Todas"
        plt.suptitle(f'{class_str} | {ylabel}', fontsize=16, fontweight='bold')
        plt.tight_layout()
        plt.show()
    
