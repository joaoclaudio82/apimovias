# =========================
# Gateway (host -> container)
# =========================
GATEWAY_PORT=8080
GATEWAY_TIMEOUT_SECONDS=30

# =========================
# Extractor: external DB
# =========================
DATABASE_HOST=seu-host-postgres
DATABASE_PORT=5432
DATABASE_DATABASE=movias
DATABASE_USER=seu-usuario
DATABASE_PASSWORD=sua-senha
DATABASE_SSL_MODE=require

# =========================
# Extractor: processing/log
# =========================
RELATORIO_QUERY_BATCH_SIZE=350
RELATORIO_QUERY_PARALLEL_WORKERS=4
EXTRACTOR_LOG_LEVEL=INFO

# =========================
# AI API: own DB/runtime
# =========================
AI_DATABASE_URL=sqlite+aiosqlite:////app/data/database.db
AI_DATABASE_URL_LOCAL=sqlite+aiosqlite:///database.db
